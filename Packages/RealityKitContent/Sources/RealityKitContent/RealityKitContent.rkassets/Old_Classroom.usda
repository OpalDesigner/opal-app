#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 1.0 (409.100.15)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def "Old_Classroom" (
        active = true
        prepend references = @Old_Classroom.usdz@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "InputTarget"
        {
            uniform token info:id = "RealityKit.InputTarget"
        }

        over "Materials"
        {
            over "Windows_OutSide"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Background"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Windows_Door_Inside"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Wall_Right"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Chair_Wood"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Chair_Metal"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Cabinet_2"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Cabinet"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Desk___Blackboard___Curtains_Support"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Black"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Wood_Pillars"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Wall_Front"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Wall_Back"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Glass"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Floor___Roof"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "SchoolDesk_Wood"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "SchoolDesk_Metal"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Papers"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Curtains"
            {
