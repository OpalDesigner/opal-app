            def RealityKitStruct "Shape"
            {
                float3 extent = (976.2803, 300, 276.1031)
                token shapeType = "Box"

                def RealityKitStruct "pose"
                {
                    float3 position = (-1.4868011, 150, -64.65904)
                }
            }
        }
    }

    def "Toy_Biplane" (
        active = true
        customData = {
            float3 rotationEulerHint = (0, 3.1415927, -0.2617994)
        }
        references = @ToyBiplane.usdz@
    )
    {
        reorder nameChildren = ["geom", "AudioLibrary", "Antique_Airplane_Landing_01"]
        quatf xformOp:orient = (-4.3337433e-8, 0.13052619, 0.9914448, 5.705481e-9)
        float3 xformOp:scale = (10, 10, 10)
        float3 xformOp:translate = (-15, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def RealityKitTimeline "Orbit"
    {
        reorder nameChildren = ["Track", "Track2", "Track3", "Track5", "Track4"]
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Orbit"
            {
                string actionKind = "orbit"
                float3 axis = (0, 0.9999354, 0)
                int blendLayer = 300
                double duration = 20
                uniform token info:id = "2E368639-EEBD-4C32-B566-5B6C8A0A397E"
                token orbitDirection = "clockwise"
                bool orientToPath = 1
                rel pivotEntity = </Root/Sphere>
                float revolutions = 1
                double startTime = 0
                rel target = </Root/Toy_Biplane>
            }
        }

        def RealityKitTrack "Track2"
        {
            def RealityKitAction "Animation"
            {
                string actionKind = "animation"
                string animation = "default scene animation"
                int blendLayer = 500
                double duration = 4.9666666984558105
                uniform token info:id = "56F36BA7-B30E-4907-A01E-639C8B79A29F"
                double loopCount = 0
                bool separateAnimatedValue = 1
                double startTime = 0
                rel target = </Root/Bird>

                def RealityKitStruct "handoffType"
                {
                }
            }
        }

        def RealityKitTrack "Track3"
        {
            def RealityKitAction "Orbit"
            {
                string actionKind = "orbit"
                float3 axis = (0, 1, 0)
                int blendLayer = 300
                double duration = 10
                uniform token info:id = "7B4564A4-CA52-4770-A468-BD95C629A292"
                token orbitDirection = "clockwise"
                bool orientToPath = 1
                rel pivotEntity = </Root/MountainTop>
                double startTime = 0
                rel target = </Root/Bird>
            }

            def RealityKitAction "Orbit2"
            {
                string actionKind = "orbit"
                float3 axis = (0, 1, 0)
                int blendLayer = 300
                double duration = 10
                uniform token info:id = "7B4564A4-CA52-4770-A468-BD95C629A292"
                token orbitDirection = "clockwise"
                bool orientToPath = 1
                rel pivotEntity = </Root/MountainTop>
                double startTime = 10.0000000001
                rel target = </Root/Bird>
                float2 ui:nodegraph:node:pos = (20, 20)
                int ui:nodegraph:node:stackingOrder = 1
            }
        }

        def RealityKitTrack "Track4"
        {
        }
    }

    def RealityKitComponent "RCP_BehaviorsContainer"
    {
        rel behaviors = </Root/OnAddedToScene>
        uniform token info:id = "RCP.BehaviorsContainer"
    }

    def Preliminary_Behavior "OnAddedToScene"
    {
        rel actions = </Root/OnAddedToScene/Action>
        uniform bool exclusive
        rel triggers = </Root/OnAddedToScene/Trigger>

        def Preliminary_Trigger "Trigger"
        {
            rel affectedObjects = </Root>
            token info:id = "SceneTransition"
        }

        def Preliminary_Action "Action"
        {
            rel affectedObjects = </Root>
            rel animationLibraryKey = </Root/Timeline>
            rel animationLibraryKeyOverrideKey = </Root/OnAddedToScene/Trigger>
            token info:id = "PlayTimeline"
            int loops = 0
            int performCount = 1
            token type = "serial"
        }
    }

    def Sphere "Sphere" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/Sphere/DefaultMaterial>
        double radius = 0.1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (2.220446e-16, 2.220446e-16, 2.220446e-16)
        float3 xformOp:translate = (0, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Material "DefaultMaterial"
        {
            prepend token outputs:surface.connect = </Root/Sphere/DefaultMaterial/DefaultSurfaceShader.outputs:surface>

            def Shader "DefaultSurfaceShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }

    def RealityKitTimeline "Timeline"
    {
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Play_Timeline"
            {
                string actionKind = "timeline"
                int blendLayer = 500
                double duration = inf
                uniform token info:id = "3727AF47-65A4-4480-A060-ED23715A01C9"
                double loopCount = 0
                double startTime = 0
                rel timeline = </Root/Orbit>
            }
        }
    }

    def "Bird" (
