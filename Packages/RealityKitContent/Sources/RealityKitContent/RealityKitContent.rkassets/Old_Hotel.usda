    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Old_Hotel", "Toy_Biplane", "RCP_BehaviorsContainer", "OnAddedToScene", "Sphere", "Orbit", "Timeline", "Bird", "Yosemite", "Riverbed", "MountainTop"]
    def "Old_Hotel" (
        active = true
        references = @Old_Hotel.usdz@
    )
    {
        float3 xformOp:scale = (0.035, 0.035, 0.035)
